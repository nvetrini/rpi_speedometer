menu "Application Configuration"

config DISPLAY_ENABLED
	bool "Enable OLED display support (SH1106)"
	default y
	imply I2C
	imply DISPLAY
	imply SSD1306
	imply CHARACTER_FRAMEBUFFER
	help
		Enable support for SH1106 OLED display over I2C.
		When enabled, the display driver and related functionality are included.
		When disabled, all display-related code is excluded.

config SD_CARD_ENABLED
	bool "Enable SD card storage via SPI"
	default y
	imply SPI
	imply SDHC
	imply SDMMC_STACK
	imply DISK_ACCESS
	imply FILE_SYSTEM
	imply FAT_FILESYSTEM_ELM
	help
		Enable support for SD card storage over SPI.
		When enabled, the SD card driver and filesystem support are included.
		When disabled, all SD card-related code and dependencies are excluded.

config APP_SIMULATION
    bool "Enable shell commands to drive simulated peripherals"
    depends on GPIO_EMUL || ADC_EMUL
    help
      Adds 'sim' shell commands to manually toggle the reed switch,
      simulate a button press, and set a fake battery voltage while
      running the app on native_sim.

config LOG_LEVEL_GLOBAL
	int "Global application log level"
	default 3
	range 0 4
	help
		Sets the default log level for all application modules.
		0 - None, 1 - Error, 2 - Warning, 3 - Info, 4 - Debug
		Individual modules can still use LOG_LEVEL_SET() to override.

endmenu

source "Kconfig.zephyr"
